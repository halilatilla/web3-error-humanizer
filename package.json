{
  "name": "web3-error-humanizer",
  "version": "2.3.2",
  "description": "Humanize cryptic Web3 and DEX errors into user-friendly messages. 770+ local patterns, optional AI fallback.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "require": "./dist/ai.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:local": "tsx examples/test-local.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "prepublishOnly": "npm run test:run && npm run build",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/halilatilla/web3-error-humanizer.git"
  },
  "homepage": "https://github.com/halilatilla/web3-error-humanizer#readme",
  "bugs": {
    "url": "https://github.com/halilatilla/web3-error-humanizer/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "web3",
    "ethereum",
    "dex",
    "error",
    "humanize",
    "error-handling",
    "blockchain",
    "solana",
    "defi",
    "swap",
    "uniswap",
    "pancakeswap",
    "metamask",
    "wallet",
    "viem",
    "ethers",
    "dapp",
    "erc20"
  ],
  "author": "halilatilla",
  "license": "MIT",
  "peerDependencies": {
    "openai": "^6.33.0",
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "openai": "^6.33.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "^2.0.0",
    "vitest": "^4.1.2"
  }
}
